@model MoviesAdmin.Models.CriticReview

@{
    ViewData["Title"] = "Delete Review";
}

<h1>Delete Review</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this draft review?
</div>

<h4>
    @Model.Movie.Title
</h4>

<hr />

<dl class="row">

    <!-- RATING -->
    <dt class="col-sm-3">
        Rating
    </dt>

    <dd class="col-sm-9">
        @Model.Rating / 5
    </dd>

    <!-- REVIEW -->
    <dt class="col-sm-3">
        Review
    </dt>

    <dd class="col-sm-9">
        @Model.Description
    </dd>

    <!-- CREATED DATE -->
    <dt class="col-sm-3">
        Created
    </dt>

    <dd class="col-sm-9">
        @Model.CreatedDate.ToString("MMMM d, yyyy")
    </dd>

</dl>

<form asp-action="Delete"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>