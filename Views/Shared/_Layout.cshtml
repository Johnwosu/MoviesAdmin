<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MoviesAdmin</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MoviesAdmin.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        @* Main MoviesAdmin navigation bar. *@
        <nav class="navbar navbar-expand-sm navbar-dark app-navbar shadow-sm mb-4">
            <div class="container">

                @* Logo and application name. The Home page is public. *@
                <a class="navbar-brand d-flex align-items-center fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/moviesadmin-logo.svg"
                         alt="MoviesAdmin Logo"
                         class="app-logo me-2" />

                    <span>MoviesAdmin</span>
                </a>

                @* Toggle navigation on smaller screens. *@
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">

                    @* Left side navigation. *@
                    <ul class="navbar-nav me-auto">

                        @* Movies can be viewed by everyone. *@
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Movies"
                               asp-action="Index">
                                Movies
                            </a>
                        </li>

                        @* Movie management options are for administrators only. *@
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Movies"
                                   asp-action="Create">
                                    Add Movie
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Genres"
                                   asp-action="Index">
                                    Genres
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="AudienceRatings"
                                   asp-action="Index">
                                    Audience Ratings
                                </a>
                            </li>
                        }

                        @* Privacy is available to everyone. *@
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>


                    @* Right side navigation. *@
                    <ul class="navbar-nav ms-auto">

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {
                            // Get the logged-in user's display name.
                            var displayName =
                                User.Identity.Name ??
                                User.Claims
                                    .FirstOrDefault(
                                        c => c.Type == "name")
                                    ?.Value ??
                                User.Claims
                                    .FirstOrDefault(
                                        c => c.Type == "email")
                                    ?.Value ??
                                "User";

                            // Split the name so initials can be created.
                            var nameParts = displayName.Split(
                                ' ',
                                StringSplitOptions.RemoveEmptyEntries);

                            string initials;

                            if (nameParts.Length >= 2)
                            {
                                initials =
                                    $"{nameParts[0][0]}{nameParts[1][0]}"
                                    .ToUpper();
                            }
                            else
                            {
                                initials =
                                    displayName
                                        .Substring(
                                            0,
                                            Math.Min(
                                                2,
                                                displayName.Length))
                                        .ToUpper();
                            }

                            @* Logged-in user's initials open the Profile page. *@
                            <li class="nav-item">
                                <a class="nav-link text-white d-flex align-items-center"
                                   asp-controller="Account"
                                   asp-action="Profile"
                                   title="@displayName">

                                    <span class="user-initials">
                                        @initials
                                    </span>

                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Account"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            @* Anonymous users see Login. *@
                            <li class="nav-item">
                                <a class="nav-link text-white"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @* Display the content of the current view. *@
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - MoviesAdmin -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Allow individual views to load their validation scripts. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>