<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MoviesAdmin</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MoviesAdmin.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        @* Main MoviesAdmin navigation bar. *@
        <nav class="navbar navbar-expand-sm navbar-dark app-navbar shadow-sm mb-4">
            <div class="container">

                @* Logo and application name. *@
                <a class="navbar-brand d-flex align-items-center fw-bold"
                   asp-area=""
                   asp-controller="Movies"
                   asp-action="Index">

                    <img src="~/images/moviesadmin-logo.svg"
                         alt="MoviesAdmin Logo"
                         class="app-logo me-2" />

                    <span>MoviesAdmin</span>
                </a>

                @* Toggle navigation on smaller screens. *@
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Movies"
                               asp-action="Index">
                                Movies
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Movies"
                               asp-action="Create">
                                Add Movie
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Genres"
                               asp-action="Index">
                                Genres
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="AudienceRatings"
                               asp-action="Index">
                                Audience Ratings
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <span class="navbar-text text-white">
                        Movie Administration
                    </span>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @* Display the content of the current view. *@
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - MoviesAdmin -
            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Allow individual views to load their validation scripts. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>