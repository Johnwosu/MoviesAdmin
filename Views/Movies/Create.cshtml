@* Styling uses Bootstrap: https://getbootstrap.com/ *@

@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Create Movie";
}

<h1>Create Movie</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- TITLE -->
            <div class="mb-3">
                <label asp-for="Title"
                       class="form-label">
                </label>

                <input asp-for="Title"
                       class="form-control" />

                <span asp-validation-for="Title"
                      class="text-danger">
                </span>
            </div>

            <!-- SYNOPSIS -->
            <div class="mb-3">
                <label asp-for="Synopsis"
                       class="form-label">
                </label>

                <textarea asp-for="Synopsis"
                          class="form-control"
                          rows="5">
                </textarea>

                <span asp-validation-for="Synopsis"
                      class="text-danger">
                </span>
            </div>

            <!-- GENRE -->
            <div class="mb-3">
                <label asp-for="GenreId"
                       class="form-label">
                    Genre
                </label>

                <select asp-for="GenreId"
                        class="form-control"
                        asp-items="ViewBag.GenreId">

                    <option value="">
                        -- Select Genre --
                    </option>

                </select>

                <span asp-validation-for="GenreId"
                      class="text-danger">
                </span>
            </div>

            <!-- CONTENT RATING -->
            <div class="mb-3">
                <label asp-for="AudienceRatingId"
                       class="form-label">
                    Content Rating
                </label>

                <select asp-for="AudienceRatingId"
                        class="form-control"
                        asp-items="ViewBag.AudienceRatingId">

                    <option value="">
                        -- Select Content Rating --
                    </option>

                </select>

                <span asp-validation-for="AudienceRatingId"
                      class="text-danger">
                </span>
            </div>


            <!-- RUNTIME -->
            <div class="row">

                <!-- RUNTIME HOURS -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        Runtime Hours
                    </label>

                    <input type="number"
                           name="runtimeHours"
                           min="0"
                           class="form-control"
                           />

                    @Html.ValidationMessage(
                        "runtimeHours",
                        null,
                        new { @class = "text-danger" })
                </div>

                <!-- RUNTIME MINUTES -->
                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        Runtime Minutes
                    </label>

                    <input type="number"
                           name="runtimeMinutesPart"
                           min="0"
                           max="59"
                           class="form-control"
                        />

                    @Html.ValidationMessage(
                        "runtimeMinutesPart",
                        null,
                        new { @class = "text-danger" })
                </div>

            </div>

            <!-- RELEASE DATE -->
            <div class="mb-3">
                <label asp-for="TheaterReleaseDate"
                       class="form-label">
                    Release Date
                </label>

                <input asp-for="TheaterReleaseDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="TheaterReleaseDate"
                      class="text-danger">
                </span>
            </div>

            <!-- IMAGE UPLOAD -->
            <div class="mb-3">
                <label class="form-label">
                    Image Upload
                </label>

                <input type="file"
                       name="imageFile"
                       class="form-control"
                       accept="image/*" />

                @Html.ValidationMessage(
                    "imageFile",
                    null,
                    new { @class = "text-danger" })
            </div>

            <!-- BUTTONS -->
            <div class="mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    Create
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Back to Movies
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}