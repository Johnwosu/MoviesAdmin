@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h1>Delete Movie</h1>

<!-- DELETE WARNING -->
<div class="alert alert-danger" role="alert">
    <strong>Warning:</strong>
    Are you sure you want to permanently delete
    <strong>@Model.Title</strong>?
</div>

<hr />

<div class="row">

    <!-- MOVIE IMAGE -->
    <div class="col-md-4 mb-4">

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 alt="@Model.Title poster"
                 class="img-fluid rounded"
                 style="max-height: 350px; object-fit: contain;" />
        }
        else
        {
            <p class="text-muted">
                No image available.
            </p>
        }

    </div>

    <!-- MOVIE INFORMATION -->
    <div class="col-md-8">

        <dl class="row">

            <!-- TITLE -->
            <dt class="col-sm-3">
                Title
            </dt>
            <dd class="col-sm-9">
                @Model.Title
            </dd>

            <!-- SYNOPSIS -->
            <dt class="col-sm-3">
                Synopsis
            </dt>
            <dd class="col-sm-9">
                @Model.Synopsis
            </dd>

            <!-- GENRE -->
            <dt class="col-sm-3">
                Genre
            </dt>
            <dd class="col-sm-9">
                @Model.Genre
            </dd>

            <!-- RATING -->
            <dt class="col-sm-3">
                Rating
            </dt>
            <dd class="col-sm-9">
                @Model.Rating
            </dd>

            <!-- RUNTIME -->
            <dt class="col-sm-3">
                Runtime
            </dt>
            <dd class="col-sm-9">
                @(Model.RuntimeMinutes / 60)h
                @(Model.RuntimeMinutes % 60)m
            </dd>

            <!-- RELEASE DATE -->
            <dt class="col-sm-3">
                Release Date
            </dt>
            <dd class="col-sm-9">
                @Model.TheaterReleaseDate.ToString("MMMM d, yyyy")
            </dd>

        </dl>

        <!-- CONFIRM DELETE -->
        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />

            <button type="submit"
                    class="btn btn-danger">
                Yes, Delete Movie
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>