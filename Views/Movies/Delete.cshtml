@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<h1>Delete Movie</h1>

<div class="alert alert-danger">
    Are you sure you want to delete this movie?
</div>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Title
    </dt>
    <dd class="col-sm-9">
        @Model.Title
    </dd>

    <dt class="col-sm-3">
        Synopsis
    </dt>
    <dd class="col-sm-9">
        @Model.Synopsis
    </dd>

    <dt class="col-sm-3">
        Genre
    </dt>
    <dd class="col-sm-9">
        @Model.Genre
    </dd>

    <dt class="col-sm-3">
        Rating
    </dt>
    <dd class="col-sm-9">
        @Model.Rating
    </dd>

    <dt class="col-sm-3">
        Runtime
    </dt>
    <dd class="col-sm-9">
        @(Model.RuntimeMinutes / 60)h
        @(Model.RuntimeMinutes % 60)m
    </dd>

    <dt class="col-sm-3">
        Release Date
    </dt>
    <dd class="col-sm-9">
        @Model.TheaterReleaseDate.ToString("MMMM d, yyyy")
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>