@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<h1>Movie administration</h1>
<p>Movies are listed by release date, newest first.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Director</th>
            <th>Genre</th>
            <th>Rating</th>
            <th>Runtime</th>
            <th>Theatre release</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.Director</td>
                <td>@movie.Genre</td>
                <td>@movie.Rating</td>
                <td>@movie.RuntimeMinutes min</td>
                <td>@movie.TheaterReleaseDate.ToString("MMM d, yyyy")</td>
            </tr>
        }
    </tbody>
</table>