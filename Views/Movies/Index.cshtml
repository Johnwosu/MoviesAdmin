@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<h1>Movie administration</h1>
<p>Movies are listed by release date, newest first.</p>

@* Open the form for adding a movie. *@
<p>
    <a asp-action="Create" class="btn btn-primary">Add Movie</a>
</p>

@if (!Model.Any())
{
    <p>No movies have been added yet.</p>
}
else
{
    @* Allow the table to scroll horizontally on smaller screens. *@
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Director</th>
                    <th>Genre</th>
                    <th>Rating</th>
                    <th>Runtime</th>
                    <th>Theatre release</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var movie in Model)
                {
                    <tr>
                        <td>@movie.Title</td>
                        <td>@movie.Director</td>
                        <td>@movie.Genre</td>
                        <td>@movie.Rating</td>

                        @* Convert total minutes to hours and remaining minutes. *@
                        <td>
                            @(movie.RuntimeMinutes / 60)h
                            @(movie.RuntimeMinutes % 60)m
                        </td>

                        <td>
                            @movie.TheaterReleaseDate.ToString("MMM d, yyyy")
                        </td>
                        @* Pass the movie ID and apply each button's colour. *@
                        <td class="text-nowrap">
                            <a asp-action="Details"
                            asp-route-id="@movie.Id"
                            class="btn btn-sm movie-details">
                                Details
                            </a>

                            <a asp-action="Edit"
                            asp-route-id="@movie.Id"
                            class="btn btn-sm movie-edit">
                                Edit
                            </a>

                            <a asp-action="Delete"
                            asp-route-id="@movie.Id"
                            class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}