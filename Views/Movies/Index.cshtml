@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Movies</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Add New Movie
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No movies have been added yet.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Genre</th>
                <th>Rating</th>
                <th>Runtime</th>
                <th>Release Date</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var movie in Model)
            {
                <tr>

                    <!-- MOVIE IMAGE -->
                    <td>
                        @if (!string.IsNullOrWhiteSpace(movie.ImageUrl))
                        {
                            <img src="@movie.ImageUrl"
                                 alt="@movie.Title poster"
                                 style="width: 150px; height: 110px; object-fit: contain;" />
                        }
                        else
                        {
                            <span class="text-muted">
                                No image
                            </span>
                        }
                    </td>

                    <!-- TITLE -->
                    <td>
                        @movie.Title
                    </td>

                    <!-- GENRE -->
                    <td>
                        @movie.Genre
                    </td>

                    <!-- RATING -->
                    <td>
                        @movie.Rating
                    </td>

                    <!-- RUNTIME -->
                    <td>
                        @(movie.RuntimeMinutes / 60)h
                        @(movie.RuntimeMinutes % 60)m
                    </td>

                    <!-- RELEASE DATE -->
                    <td>
                        @movie.TheaterReleaseDate.ToString("MMM d, yyyy")
                    </td>

                    <!-- ACTIONS -->
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@movie.Id"
                           class="btn btn-sm btn-info">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@movie.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@movie.Id"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
}