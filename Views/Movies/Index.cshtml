@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Movies";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h1>Movies</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Add New Movie
    </a>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No movies have been added yet.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">

        <thead>
            <tr>
                <th>Title</th>
                <th>Genre</th>
                <th>Rating</th>
                <th>Runtime</th>
                <th>Release Date</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var movie in Model)
            {
                <tr>

                    <td>
                        @movie.Title
                    </td>

                    <td>
                        @movie.Genre
                    </td>

                    <td>
                        @movie.Rating
                    </td>

                    <td>
                        @(movie.RuntimeMinutes / 60)h
                        @(movie.RuntimeMinutes % 60)m
                    </td>

                    <td>
                        @movie.TheaterReleaseDate.ToString("MMM d, yyyy")
                    </td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@movie.Id"
                           class="btn btn-sm btn-info">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@movie.Id"
                           class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@movie.Id"
                           class="btn btn-sm btn-danger">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>
}