@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Movie Details";

    var publishedReviews =
        ViewBag.PublishedReviews
        as List<MoviesAdmin.Models.CriticReview>
        ?? new List<MoviesAdmin.Models.CriticReview>();

    var reviewerNames =
        ViewBag.ReviewerNames
        as Dictionary<string, string>
        ?? new Dictionary<string, string>();
}

<h1>Movie Details</h1>

<hr />

<div class="row">

    <!-- MOVIE IMAGE -->
    <div class="col-md-5 mb-4">

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 alt="@Model.Title poster"
                 class="img-fluid rounded shadow-sm"
                 style="width: 100%;
                        max-width: 350px;
                        max-height: 550px;
                        object-fit: contain;" />
        }
        else
        {
            <p class="text-muted">
                No image available.
            </p>
        }

    </div>

    <!-- MOVIE INFORMATION -->
    <div class="col-md-7">

        <dl class="row">

            <!-- TITLE -->
            <dt class="col-sm-3">
                Title
            </dt>
            <dd class="col-sm-9">
                @Model.Title
            </dd>

            <!-- SYNOPSIS -->
            <dt class="col-sm-3">
                Synopsis
            </dt>
            <dd class="col-sm-9">
                @Model.Synopsis
            </dd>

            <!-- GENRE -->
            <dt class="col-sm-3">
                Genre
            </dt>
            <dd class="col-sm-9">
                @Model.Genre.Title
            </dd>

            <!-- CONTENT RATING -->
            <dt class="col-sm-3">
                Content Rating
            </dt>
            <dd class="col-sm-9">
                @Model.AudienceRating.Title
            </dd>

            <!-- RUNTIME -->
            <dt class="col-sm-3">
                Runtime
            </dt>
            <dd class="col-sm-9">
                @(Model.RuntimeMinutes / 60)h
                @(Model.RuntimeMinutes % 60)m
            </dd>

            <!-- RELEASE DATE -->
            <dt class="col-sm-3">
                Release Date
            </dt>
            <dd class="col-sm-9">
                @Model.TheaterReleaseDate.ToString("MMMM d, yyyy")
            </dd>

        </dl>


        <!-- PUBLISHED REVIEWS -->
        <hr />

        <h3>
            Published Reviews: @ViewBag.PublishedReviewCount
        </h3>

        @if (!publishedReviews.Any())
        {
            <p class="text-muted">
                No published reviews yet.
            </p>
        }
        else
        {
            @foreach (var review in publishedReviews)
            {
                var reviewerName =
                    reviewerNames.TryGetValue(
                        review.CreatedBy,
                        out var name)
                    && !string.IsNullOrWhiteSpace(name)
                        ? name
                        : "Critic";

                <div class="card mb-3">
                    <div class="card-body">

                        <!-- REVIEWER -->
                        <h5 class="card-title mb-1">
                            @reviewerName
                        </h5>

                        <!-- RATING -->
                        <div class="mb-2">
                            <strong>
                                Rating: @review.Rating / 5
                            </strong>
                        </div>

                        <!-- REVIEW -->
                        <p class="card-text">
                            @review.Description
                        </p>

                        <!-- REVIEW DATE -->
                        <small class="text-muted">
                            @review.CreatedDate.ToString("MMMM d, yyyy")
                        </small>

                    </div>
                </div>
            }
        }


        <!-- BUTTONS -->
        <div class="mt-4">

            <!-- Only administrators can edit movies. -->
            @if (User.IsInRole("Administrator"))
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Edit
                </a>
            }

            <!-- Authenticated users can return to the movie list. -->
            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Movies
            </a>

        </div>

    </div>

</div>