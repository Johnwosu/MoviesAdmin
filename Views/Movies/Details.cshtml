@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<h1>Movie Details</h1>

<hr />

<div class="row">
    <div class="col-md-8">

        <dl class="row">

            <!-- TITLE -->
            <dt class="col-sm-3">
                Title
            </dt>
            <dd class="col-sm-9">
                @Model.Title
            </dd>

            <!-- SYNOPSIS -->
            <dt class="col-sm-3">
                Synopsis
            </dt>
            <dd class="col-sm-9">
                @Model.Synopsis
            </dd>

            <!-- GENRE -->
            <dt class="col-sm-3">
                Genre
            </dt>
            <dd class="col-sm-9">
                @Model.Genre
            </dd>

            <!-- RATING -->
            <dt class="col-sm-3">
                Rating
            </dt>
            <dd class="col-sm-9">
                @Model.Rating
            </dd>

            <!-- RUNTIME -->
            <dt class="col-sm-3">
                Runtime
            </dt>
            <dd class="col-sm-9">
                @(Model.RuntimeMinutes / 60)h
                @(Model.RuntimeMinutes % 60)m
            </dd>

            <!-- RELEASE DATE -->
            <dt class="col-sm-3">
                Release Date
            </dt>
            <dd class="col-sm-9">
                @Model.TheaterReleaseDate.ToString("MMMM d, yyyy")
            </dd>

        </dl>

        <div class="mt-4">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Movies
            </a>

        </div>

    </div>
</div>