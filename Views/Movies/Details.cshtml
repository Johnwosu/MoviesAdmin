@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Movie Details";
}

<h1>Movie Details</h1>

<hr />

<div class="row">

    <!-- MOVIE IMAGE -->
    <div class="col-md-4 mb-4">

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl"
                 alt="@Model.Title poster"
                 class="img-fluid rounded"
                 style="max-height: 450px; object-fit: contain;" />
        }
        else
        {
            <p class="text-muted">
                No image available.
            </p>
        }

    </div>

    <!-- MOVIE INFORMATION -->
    <div class="col-md-8">

        <dl class="row">

            <!-- TITLE -->
            <dt class="col-sm-3">
                Title
            </dt>
            <dd class="col-sm-9">
                @Model.Title
            </dd>

            <!-- SYNOPSIS -->
            <dt class="col-sm-3">
                Synopsis
            </dt>
            <dd class="col-sm-9">
                @Model.Synopsis
            </dd>

            <!-- GENRE -->
            <dt class="col-sm-3">
                Genre
            </dt>
            <dd class="col-sm-9">
                @Model.Genre.Title
            </dd>

            <!-- RATING -->
            <dt class="col-sm-3">
                Content Rating
            </dt>
            <dd class="col-sm-9">
                @Model.AudienceRating.Title
            </dd>

            <!-- RUNTIME -->
            <dt class="col-sm-3">
                Runtime
            </dt>
            <dd class="col-sm-9">
                @(Model.RuntimeMinutes / 60)h
                @(Model.RuntimeMinutes % 60)m
            </dd>

            <!-- RELEASE DATE -->
            <dt class="col-sm-3">
                Release Date
            </dt>
            <dd class="col-sm-9">
                @Model.TheaterReleaseDate.ToString("MMMM d, yyyy")
            </dd>

        </dl>

        <!-- BUTTONS -->
        <div class="mt-4">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Edit
            </a>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Movies
            </a>

        </div>

    </div>

</div>