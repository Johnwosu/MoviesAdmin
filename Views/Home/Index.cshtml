@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">

    <h1 class="display-4">
        MoviesAdmin
    </h1>

    <p class="lead">
        A secure movie administration and critic review application.
    </p>

    <p>
        Administrators can manage movie information,
        while movie critics can rate and review movies.
    </p>

    @if (!(User.Identity?.IsAuthenticated ?? false))
    {
        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary btn-lg">
            Login
        </a>
    }
    else
    {
        <a asp-controller="Movies"
           asp-action="Index"
           class="btn btn-primary btn-lg">
            View Movies
        </a>
    }

</div>